PORT=5000
# MongoDB (same database that the client's Better Auth uses)
MONGODB_URI=
MONGODB_DB=salonbook
# URL of the Next.js client (used for CORS, Stripe redirects and JWT verification)
CLIENT_URL=http://localhost:3000
# Must equal BETTER_AUTH_URL of the client (JWT issuer)
AUTH_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd
IMGBB_API_KEY=
